# ==============================================================================
# Nepali Devanagari OCR Pipeline - Environment Configuration Template
# Copy this file to .env and configure your credentials and pipeline settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Provider & Credentials
# ------------------------------------------------------------------------------
# API key for the vision model endpoint.
# You can use either FREEMODEL_API_KEY or OPENAI_API_KEY.
FREEMODEL_API_KEY=your_freemodel_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Base URL for the OpenAI-compatible API endpoint:
# Default FreeModel endpoint: https://api.freemodel.dev/v1
# Official OpenAI endpoint:   https://api.openai.com/v1
# OpenRouter endpoint:        https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.freemodel.dev/v1

# Vision model name (e.g., gpt-4o, gpt-4o-mini, etc.)
OCR_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. Concurrency & Rate Limiting
# ------------------------------------------------------------------------------
# Maximum concurrent pages processed per PDF
OCR_PAGES_PARALLEL=2

# Maximum concurrent PDFs processed in parallel
OCR_PDFS_PARALLEL=1

# Maximum total concurrent API calls across all PDFs/pages
OCR_API_PARALLEL=1

# Minimum delay (in seconds) between consecutive API request starts
OCR_API_MIN_INTERVAL=5.0

# ------------------------------------------------------------------------------
# 3. Image Rendering & Vision Preprocessing
# ------------------------------------------------------------------------------
# DPI used to rasterize PDF pages (higher = better quality, larger payload)
OCR_DPI=240

# Format sent to the vision API: 'jpeg' (recommended) or 'png'
OCR_IMAGE_FORMAT=jpeg

# Compression quality when using JPEG format (1-95)
OCR_JPEG_QUALITY=90

# Image detail hint for OpenAI vision API ('auto', 'low', 'high')
OCR_IMAGE_DETAIL=auto

# ------------------------------------------------------------------------------
# 4. Resilience, Timeouts & Retries
# ------------------------------------------------------------------------------
# Per-request timeout in seconds
OCR_REQUEST_TIMEOUT=180

# Maximum retry attempts per page on failure/rate limit
OCR_RETRIES=3

# Initial delay in seconds before first retry
OCR_RETRY_BASE_DELAY=5.0

# Maximum delay cap in seconds for exponential backoff
OCR_RETRY_MAX_DELAY=60.0

# ------------------------------------------------------------------------------
# 5. Directory Paths
# ------------------------------------------------------------------------------
# Input directory containing source PDF documents
OCR_INPUT_DIR=data

# Output directory for generated DOCX documents
OCR_OUTPUT_DIR=output
